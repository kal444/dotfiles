#!/usr/bin/env bash

for i in `seq 1 9`; do
  # wait until interface is active again.
  # is there a better way to do this?
  ifconfig en0 | grep -q 'status: active' && break;
  sleep 5
done

ping -q -c1 berunda >/dev/null || exit; # server not up

# pw=$(security find-internet-password -w -a kal -l berunda)

prefix=$HOME

mkdir -p $prefix/mnt/berunda/{media,public,attic,kal}

# mount only when it's not mounted
mount | grep -q $prefix/mnt/berunda/media  || mount -v -t smbfs -o -f=644,-d=755 smb://berunda/media  $prefix/mnt/berunda/media
mount | grep -q $prefix/mnt/berunda/public || mount -v -t smbfs -o -f=644,-d=755 smb://berunda/public $prefix/mnt/berunda/public
mount | grep -q $prefix/mnt/berunda/attic  || mount -v -t smbfs -o -f=644,-d=755 smb://berunda/attic  $prefix/mnt/berunda/attic
mount | grep -q $prefix/mnt/berunda/kal    || mount -v -t smbfs -o -f=644,-d=755 smb://berunda/home   $prefix/mnt/berunda/kal
