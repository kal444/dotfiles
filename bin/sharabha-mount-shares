#!/usr/bin/env bash

for i in `seq 1 9`; do
  # wait until interface is active again.
  # is there a better way to do this?
  ifconfig en0 | grep -q 'status: active' && break;
  sleep 5
done

ping -q -c1 sharabha >/dev/null || exit; # server not up

# pw=$(security find-internet-password -w -a kal -l sharabha)

prefix=$HOME

mkdir -p $HOME/mnt/sharabha/{media,public,attic,kal}

# mount only when it's not mounted
mount | grep -q $prefix/mnt/sharabha/media  || mount -v -t smbfs -o -f=644,-d=755 smb://sharabha/media  $prefix/mnt/sharabha/media
mount | grep -q $prefix/mnt/sharabha/public || mount -v -t smbfs -o -f=644,-d=755 smb://sharabha/public $prefix/mnt/sharabha/public
mount | grep -q $prefix/mnt/sharabha/attic  || mount -v -t smbfs -o -f=644,-d=755 smb://sharabha/attic  $prefix/mnt/sharabha/attic
mount | grep -q $prefix/mnt/sharabha/kal    || mount -v -t smbfs -o -f=644,-d=755 smb://sharabha/home   $prefix/mnt/sharabha/kal
